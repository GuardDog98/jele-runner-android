<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.guarddog.jele.MainActivity">

    <com.guarddog.jele.GameGLSurfaceView
        android:id="@+id/glView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="top"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jele Runner"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnShop"
                android:layout_width="96dp"
                android:layout_height="40dp"
                android:text="Shop"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvCoins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Coins: 0"
            android:textColor="#FFD15C"
            android:textSize="18sp"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Distance: 0m"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Start overlay -->
    <FrameLayout
        android:id="@+id/overlayStart"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jele Runner"
                android:textSize="36sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnStart"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="Start" />
        </LinearLayout>
    </FrameLayout>

    <!-- Shop overlay -->
    <FrameLayout
        android:id="@+id/overlayShop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shop"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnSkin0"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:text="Starter (Free)"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnSkin1"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:text="Orange - 15"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnSkin2"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:text="Green - 30"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnShopClose"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:text="Close" />
        </LinearLayout>
    </FrameLayout>

    <!-- Game over overlay -->
    <FrameLayout
        android:id="@+id/overlayGameOver"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:gravity="center">

            <TextView
                android:id="@+id/tvGameOver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Game Over"
                android:textSize="32sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvFinalScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Coins: 0  Distance: 0m"
                android:textColor="#FFD15C"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnRestart"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="Restart" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btnLeft"
            android:layout_width="96dp"
            android:layout_height="56dp"
            android:text="Left" />

        <Button
            android:id="@+id/btnJump"
            android:layout_width="96dp"
            android:layout_height="56dp"
            android:text="Jump"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp" />

        <Button
            android:id="@+id/btnRight"
            android:layout_width="96dp"
            android:layout_height="56dp"
            android:text="Right" />
    </LinearLayout>

</FrameLayout>
